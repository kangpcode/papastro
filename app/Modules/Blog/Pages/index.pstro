---
use App\Modules\Blog\Models\Post;
$posts = Post::published()->latest()->paginate(10, (int)request('page', 1));
$pageTitle = 'Blog';
---
@layout('layouts.base')

@section('content')
<div class="blog-header">
    <div class="container">
        <h1>Blog</h1>
        <p style="color: var(--color-muted); margin-top: 8px;">{{ $posts['total'] }} articles published</p>
    </div>
</div>

<div class="container">
    @if(empty($posts['data']))
        <div style="text-align: center; padding: 80px 0; color: var(--color-muted);">
            <p style="font-size: 48px">📝</p>
            <p style="margin-top: 16px; font-size: 18px;">No posts yet. <a href="/blog/create" style="color: var(--color-primary);">Write the first one →</a></p>
        </div>
    @else
        <div class="posts-grid">
            @foreach ($posts['data'] as $post)
                <a href="/blog/{{ $post->slug }}" class="post-card">
                    <div style="font-size: 12px; color: var(--color-muted); margin-bottom: 12px; text-transform: uppercase; letter-spacing: 0.05em;">
                        {{ $post->getReadingTime() }} min read &middot; {{ date('M j, Y', strtotime($post->created_at)) }}
                    </div>
                    <h2>{{ $post->title }}</h2>
                    @if($post->excerpt)
                    <p style="margin-top: 10px;">{{ $post->excerpt }}</p>
                    @endif
                    <div style="margin-top: 16px; color: var(--color-primary); font-size: 14px; font-weight: 600;">
                        Read more →
                    </div>
                </a>
            @endforeach
        </div>

        @if($posts['last_page'] > 1)
        <div style="display: flex; justify-content: center; gap: 8px; margin: 48px 0;">
            @if($posts['current_page'] > 1)
            <a href="?page={{ $posts['current_page'] - 1 }}" class="btn btn-outline">← Previous</a>
            @endif
            <span style="padding: 10px 20px; color: var(--color-muted); font-size: 14px;">
                Page {{ $posts['current_page'] }} of {{ $posts['last_page'] }}
            </span>
            @if($posts['current_page'] < $posts['last_page'])
            <a href="?page={{ $posts['current_page'] + 1 }}" class="btn btn-outline">Next →</a>
            @endif
        </div>
        @endif
    @endif
</div>
@endsection
