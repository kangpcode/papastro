---
$pageTitle = 'Write New Article';
$errors = session('errors') ?? [];
---
@layout('layouts.base')

@section('content')
<div style="padding: calc(var(--navbar-height) + 32px) 0 80px;">
    <div class="container" style="max-width: 820px;">

        <div style="margin-bottom: 24px;">
            <a href="/blog" style="display: inline-flex; align-items: center; gap: 6px; color: var(--color-muted); text-decoration: none; font-size: 14px; transition: color 0.2s;">
                <pascon:arrow-left size="16" /> Back to Blog
            </a>
        </div>

        <div style="background: var(--color-bg-2); border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: clamp(24px, 5vw, 40px); box-shadow: var(--shadow-md);">
            <div style="margin-bottom: 32px; border-bottom: 1px solid var(--color-border); padding-bottom: 20px;">
                <h1 style="font-size: clamp(24px, 4vw, 32px); font-weight: 800; letter-spacing: -0.03em; margin-bottom: 8px;">
                    Write New Article
                </h1>
                <p style="color: var(--color-muted); font-size: 15px;">
                    Share insights, tutorials, or updates with the Papastro community.
                </p>
            </div>

            @if(!empty($errors))
                <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; padding: 14px 18px; border-radius: var(--radius-md); font-size: 14px; margin-bottom: 24px;">
                    <div style="display: flex; align-items: center; gap: 8px; font-weight: 600; margin-bottom: 6px;">
                        <pascon:alert-circle size="18" /> Please fix the following errors:
                    </div>
                    <ul style="margin-left: 24px; line-height: 1.6;">
                        @foreach ($errors as $fieldErrors)
                            @foreach ((array)$fieldErrors as $msg)
                                <li>{{ $msg }}</li>
                            @endforeach
                        @endforeach
                    </ul>
                </div>
            @endif

            <form action="/blog" method="POST">
                @csrf

                <div style="margin-bottom: 24px;">
                    <label for="title" style="display: block; font-size: 14px; font-weight: 600; margin-bottom: 8px; color: var(--color-text);">
                        Article Title <span style="color: var(--color-danger);">*</span>
                    </label>
                    <input 
                        type="text" 
                        id="title" 
                        name="title" 
                        value="{{ old('title') }}" 
                        required 
                        placeholder="e.g., Building Scalable Microservices with Papastro" 
                        style="width: 100%; background: var(--color-bg-3); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 12px 16px; color: var(--color-text); font-size: 15px; outline: none; transition: border-color 0.2s;"
                        onfocus="this.style.borderColor='var(--color-primary)'"
                        onblur="this.style.borderColor='var(--color-border)'"
                    >
                </div>

                <div style="margin-bottom: 24px;">
                    <label for="excerpt" style="display: block; font-size: 14px; font-weight: 600; margin-bottom: 8px; color: var(--color-text);">
                        Excerpt / Summary
                    </label>
                    <textarea 
                        id="excerpt" 
                        name="excerpt" 
                        rows="3" 
                        placeholder="Brief summary displayed on post previews and social share cards..." 
                        style="width: 100%; background: var(--color-bg-3); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 12px 16px; color: var(--color-text); font-size: 14px; font-family: var(--font-sans); outline: none; resize: vertical; line-height: 1.5; transition: border-color 0.2s;"
                        onfocus="this.style.borderColor='var(--color-primary)'"
                        onblur="this.style.borderColor='var(--color-border)'"
                    >{{ old('excerpt') }}</textarea>
                </div>

                <div style="margin-bottom: 24px;">
                    <label for="body" style="display: block; font-size: 14px; font-weight: 600; margin-bottom: 8px; color: var(--color-text);">
                        Content Body <span style="color: var(--color-danger);">*</span>
                    </label>
                    <textarea 
                        id="body" 
                        name="body" 
                        rows="14" 
                        required 
                        placeholder="Write article content here..." 
                        style="width: 100%; background: var(--color-bg-3); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 14px 16px; color: var(--color-text); font-size: 15px; font-family: var(--font-mono); outline: none; resize: vertical; line-height: 1.6; transition: border-color 0.2s;"
                        onfocus="this.style.borderColor='var(--color-primary)'"
                        onblur="this.style.borderColor='var(--color-border)'"
                    >{{ old('body') }}</textarea>
                </div>

                <div style="margin-bottom: 32px; display: flex; align-items: center; gap: 10px;">
                    <input 
                        type="checkbox" 
                        id="published" 
                        name="published" 
                        value="1" 
                        checked 
                        style="width: 18px; height: 18px; accent-color: var(--color-primary); cursor: pointer;"
                    >
                    <label for="published" style="font-size: 14px; font-weight: 500; color: var(--color-text); cursor: pointer; user-select: none;">
                        Publish immediately (visible to all readers)
                    </label>
                </div>

                <div style="display: flex; align-items: center; justify-content: flex-end; gap: 12px;">
                    <a href="/blog" class="btn btn-outline" style="padding: 10px 20px;">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 8px; padding: 10px 24px;">
                        <pascon:pencil size="16" /> Publish Article
                    </button>
                </div>
            </form>
        </div>

    </div>
</div>
@endsection
