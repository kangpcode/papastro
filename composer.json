{
    "name": "kangpcode/papastro",
    "description": "Papastro — Hybrid PHP + Astro-style Modular Monolith Framework",
    "type": "project",
    "keywords": ["framework", "php", "astro", "island", "modular", "monolith"],
    "homepage": "https://github.com/kangpcode/papastro",
    "license": "MIT",
    "authors": [
        {
            "name": "kangpcode (Dhafa Nazula Permadi)",
            "role": "Creator"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "suggest": {
        "ext-pcntl": "Required for multi-worker Native Octane-style runtime server",
        "ext-sockets": "Required for high-performance socket runtime and Pasway WebSockets",
        "ext-swoole": "Required for running Swoole coroutine runtime server",
        "ext-pdo_sqlite": "Required for default SQLite database driver",
        "ext-pdo_mysql": "Required for MySQL database driver",
        "ext-pdo_pgsql": "Required for PostgreSQL database driver"
    },
    "bin": [
        "papastro"
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Papastro\\": "app/Core/",
            "Plugins\\": "plugins/"
        },
        "classmap": [
            "app/"
        ],
        "files": [
            "app/Core/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php papastro setup --create"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "4.0.x-dev"
        }
    },
    "support": {
        "issues": "https://github.com/kangpcode/papastro/issues",
        "source": "https://github.com/kangpcode/papastro"
    },
    "config": {
        "vendor-dir": "libs",
        "bin-dir": "libs/bin",
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
