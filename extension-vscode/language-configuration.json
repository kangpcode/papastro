{
  "comments": {
    "blockComment": ["<!--", "-->"]
  },
  "brackets": [
    ["<!--", "-->"],
    ["<", ">"],
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "`", "close": "`", "notIn": ["string", "comment"] },
    { "open": "<!--", "close": "-->", "notIn": ["comment"] },
    { "open": "{{", "close": "}}" },
    { "open": "{!!", "close": "!!}" }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["<", ">"],
    ["'", "'"],
    ["\"", "\""],
    ["`", "`"],
    ["{{", "}}"],
    ["{!!", "!!}"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(---|<[a-zA-Z0-9_:-]+|@(section|if|unless|foreach|forelse|for|while|isset|empty|auth|guest|verbatim))\\b",
      "end": "^\\s*(---|\\/|<\\/[a-zA-Z0-9_:-]+>|@(endsection|endif|endunless|endforeach|endforelse|endfor|endwhile|endisset|endempty|endauth|endguest|endverbatim))\\b"
    }
  },
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)"
}

