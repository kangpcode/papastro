{
  "name": "papastro-vscode",
  "displayName": "Papastro - Language, Syntax & File Icons",
  "description": "Official language support, TextMate syntax highlighting, code snippets, and file icon theme for Papastro Hybrid Framework (.pstro). Compatible with VS Code, Antigravity IDE, Cursor, and VSCodium.",
  "version": "4.0.0",
  "publisher": "kangpcode",
  "author": {
    "name": "kangpcode (Dhafa Nazula Permadi)",
    "email": "dhafanavy@gmail.com",
    "url": "https://github.com/kangpcode"
  },
  "homepage": "https://github.com/kangpcode/papastro",
  "repository": {
    "type": "git",
    "url": "https://github.com/kangpcode/papastro.git"
  },
  "bugs": {
    "url": "https://github.com/kangpcode/papastro/issues"
  },
  "scripts": {
    "package": "vsce package --no-git-tag-version",
    "publish:vscode": "vsce publish",
    "publish:openvsx": "ovsx publish papastro-vscode-3.0.0.vsix"
  },
  "galleryBanner": {
    "color": "#08305b",
    "theme": "dark"
  },
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Themes"
  ],
  "keywords": [
    "papastro",
    "pstro",
    "astro",
    "island",
    "php",
    "laravel",
    "blade",
    "syntax",
    "icons"
  ],
  "contributes": {
    "languages": [
      {
        "id": "papastro",
        "aliases": [
          "Papastro",
          "papastro",
          "pstro"
        ],
        "extensions": [
          ".pstro"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/papastro.svg",
          "dark": "./icons/papastro.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "papastro",
        "scopeName": "text.html.papastro",
        "path": "./syntaxes/papastro.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.frontmatter.php": "php",
          "meta.embedded.expression.escaped.papastro": "php",
          "meta.embedded.expression.raw.papastro": "php",
          "source.css": "css",
          "source.js": "javascript"
        }
      }
    ],
    "snippets": [
      {
        "language": "papastro",
        "path": "./snippets/papastro.code-snippets"
      }
    ],
    "iconThemes": [
      {
        "id": "papastro-icon-theme",
        "label": "Papastro File Icons",
        "path": "./icons/papastro-icon-theme.json"
      }
    ]
  }
}

