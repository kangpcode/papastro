##
## Papastro Framework — Environment Configuration
## Copy this file to .env and fill in your values.
##

# Application
# Project mode: modules (app/Modules only) or full (modules + plugins)
PAPASTRO_MODE=full
APP_NAME="Papastro App"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=en

# Database Settings
# Supported drivers: sqlite, mysql, mariadb, pgsql, supabase, mongodb, sqlsrv
# Default: Zero-configuration SQLite (ready out of the box)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# MySQL / MariaDB
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=papastro
# DB_USERNAME=root
# DB_PASSWORD=

# PostgreSQL
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=papastro
# DB_USERNAME=postgres
# DB_PASSWORD=
# DB_SSLMODE=prefer

# Supabase (PostgreSQL with SSL & pgBouncer pooler or direct)
# DB_CONNECTION=supabase
# SUPABASE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# SUPABASE_DB_PORT=6543
# SUPABASE_DB_DATABASE=postgres
# SUPABASE_DB_USERNAME=postgres.your-project-ref
# SUPABASE_DB_PASSWORD=your-secure-supabase-password
# Or direct single URL:
# DATABASE_URL="postgresql://postgres.ref:pass@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require"

# MongoDB (NoSQL Document Store)
# DB_CONNECTION=mongodb
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DATABASE=papastro
# Atlas Cloud: MONGODB_URI="mongodb+srv://user:pass@cluster0.mongodb.net/papastro?retryWrites=true&w=majority"

# PWA
PWA_SHORT_NAME=Papastro
PWA_THEME_COLOR=#0f172a
PWA_BG_COLOR=#0f172a
PWA_STRATEGY=cache-first

# SEO
SEO_TITLE="Papastro App"
SEO_DESCRIPTION="Built with Papastro Framework"
SEO_KEYWORDS="papastro, php, framework"
SEO_AUTHOR=
SEO_ROBOTS="index, follow"
SEO_TWITTER_SITE=
SEO_TWITTER_CREATOR=

# Debug (requires APP_DEBUG=true)
PAPASTRO_DEBUGBAR=true
PAPASTRO_DEV_OVERLAY=true

# Plugins (optional third-party plug-and-play modules)
PLUGINS_ENABLED=true
PLUGINS_AUTO_DISCOVER=true
